#!/usr/bin/env bash

exampleFile=$(find / -xdev -name Lab11_Question1.cpp)
mFile=$(find / -xdev -name makefile)

cp "$exampleFile" /autograder/source/Lab11_Question1.cpp
cp "$mFile" /autograder/source/makefile 2>/dev/null || true

cd /autograder/source

g++ -std=gnu++17 -O2 -Wall Lab11_Question1.cpp -o Lab11_Question1.out

python3 run_tests.py > /autograder/results/results.json
